# PostgreSQL 연결 문자열 (로컬 예: docker run 으로 띄운 Postgres)
DATABASE_URL=postgres://dogchef:dogchef@localhost:5432/dogchef

# JWT 서명 키 (32자 이상의 무작위 문자열)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Claude API 키. 비워두면 AI 기능만 503을 반환하고 나머지는 정상 동작합니다.
ANTHROPIC_API_KEY=

# 사용할 모델 (기본: claude-haiku-5-5)
AI_MODEL=claude-haiku-5-5

PORT=3000
