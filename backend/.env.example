# 이 파일을 .env 로 복사해서 쓰세요.
PORT=4040
# 4000번은 이 PC의 다른 프로젝트(MALRANG)가 쓰고 있어서 4040 을 쓴다.

# 로그인 토큰 서명 키. 운영에서는 반드시 길고 랜덤한 값으로 바꾸세요.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# 비워 두면 data/dogchef.sqlite 파일 DB 를 씁니다 (설치 불필요).
# Postgres 를 쓰려면 주소를 넣으세요. 예: postgres://user:pass@localhost:5432/dogchef
DATABASE_URL=

# 허용할 프론트 주소 (쉼표 구분). 비우면 전부 허용 (개발용).
CORS_ORIGINS=

# DB 에 레시피가 하나도 없으면 예시 레시피 8개를 넣습니다. 끄려면 false.
SEED_SAMPLE_DATA=true

# 업로드 이미지를 저장할 폴더와, 이미지 주소를 만들 때 쓸 공개 주소 (배포 시).
UPLOAD_DIR=uploads
PUBLIC_URL=
